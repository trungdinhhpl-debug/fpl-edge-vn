# Root env — used by docker-compose and shared config.
# Copy to .env and fill in. NEVER commit real secrets.

# Optional: The Odds API key (probability provider). Empty => internal model fallback.
# Free tier: https://the-odds-api.com/
ODDS_API_KEY=

# Market inversion (see docs/METHODOLOGY.md §2b). Defaults are fine.
# Asian handicap is the sharpest of the three markets, but a request costs
# (markets x regions) credits — including it takes a sync from 2 to 3.
# ODDS_INCLUDE_HANDICAP=true
# Relative weight of each market in the joint fit of the two lambdas.
# ODDS_WEIGHT_1X2=1.0
# ODDS_WEIGHT_TOTALS=1.0
# ODDS_WEIGHT_HANDICAP=1.0
# Dixon-Coles low-score correlation; 0 disables the correction.
# ODDS_DIXON_COLES_RHO=-0.13

# These are consumed by docker-compose service env blocks:
# (defaults already set in docker-compose.yml; override here if needed)
# PROJECTION_HORIZON=8
# MONTECARLO_ITERATIONS=10000

# ---- Chế độ tiền mùa (xem docs/METHODOLOGY.md §1b) ----
# FPL API KHÔNG công bố huấn luyện viên hay lịch sử chuyển nhượng, nên hai danh
# sách này phải khai bằng tay. Để rỗng = CHƯA AI KHAI, không phải "không có ai".
# NEW_MANAGER_CLUBS=TOT,MUN
# NEW_SIGNING_PLAYERS=427,481
# Mức tin vào dữ liệu mùa trước (thấp hơn = siết mạnh hơn về mức nền vị trí)
# PRIOR_WEIGHT_NEW_MANAGER=0.6
# PRIOR_WEIGHT_NEW_SIGNING=0.4

# ---- Kèo ghi bàn theo cầu thủ (player_goal_scorer_anytime) ----
# Kèo cầu thủ CHỈ lấy được mỗi lần một trận qua /events/{id}/odds, nên tốn
# 1 credit MỖI TRẬN (~10 credit một vòng) — trong khi kèo đội chỉ tốn 3 cho cả
# vòng. Với gói 500 credit/tháng, ba núm dưới đây là thứ giữ cho nó vừa quota.
# ODDS_PLAYER_GOALS_ENABLED=true
# ODDS_PLAYER_GOALS_MAX_FIXTURES=10
# Chỉ gọi lại một trận sau bấy nhiêu giờ -> lịch đồng bộ 6 tiếng vẫn chỉ tốn
# ~10 credit mỗi ngày thay vì 40.
# ODDS_PLAYER_GOALS_MIN_REFRESH_HOURS=24
# Dừng lấy kèo cầu thủ khi quota còn ít hơn mức này (ưu tiên kèo đội, vì nó đổi
# lambda của MỌI cầu thủ).
# ODDS_PLAYER_GOALS_RESERVE_CREDITS=30
# Kèo cũ hơn mốc này chỉ hiển thị tham khảo, không đưa vào xP.
# ODDS_PLAYER_GOALS_MAX_AGE_HOURS=72
#
# ĐIỀU KIỆN ÁP DỤNG — unknown | appears | any. Mặc định "unknown" là CÓ CHỦ Ý:
# The Odds API không phát hành luật thanh toán, nên ta không biết giá là
# P(ghi bàn) hay P(ghi bàn | ra sân), và hai cách hiểu cho ra số bàn kỳ vọng khác
# nhau rõ rệt. Khi chưa xác minh, kèo chỉ HIỂN THỊ và KHÔNG vào xP.
# Đặt "appears" sau khi tự đọc điều khoản của nhà cái mình dùng.
# ODDS_PLAYER_GOALS_CONDITION=unknown
# Trọng số của thị trường khi pha với mô hình cho thành phần ghi bàn (0..1).
# GIẢ ĐỊNH CHƯA KIỂM CHỨNG — bằng trọng số kèo cấp đội vì chưa có cơ sở chọn khác.
# ODDS_PLAYER_GOALS_WEIGHT=0.7
# Region nhà cái, dùng chung cho mọi lệnh gọi The Odds API.
# ODDS_REGION=uk

# ---- Vai trò chiến thuật & điểm yếu đối thủ theo vị trí ----
# Tệp JSON khai vai trò từng cầu thủ (LW/RW/ST/AM/CM/DM/LB/RB/LWB/RWB/CB/GK).
# FPL API KHÔNG có dữ liệu này, và nó KHÔNG được suy ra từ nhãn GK/DEF/MID/FWD.
# Để rỗng = tính năng tắt: hệ số điều chỉnh theo vị trí đúng bằng 1.0 và giao diện
# hiện "Chưa đủ dữ liệu". Định dạng: xem app/engine/roles.py.
# PLAYER_ROLES_JSON=/data/player_roles.json
# POSITIONAL_ADJUSTMENT_ENABLED=true
#
# Nguồn vai trò TỰ ĐỘNG: API công khai của Premier League
# (app/providers/pl_positions.py) — không cần khoá, trả `info.positionInfo` kiểu
# "Left Full Back" / "Right Winger" / "Centre Central Defender".
#
# ĐANG BẬT (mặc định true). robots.txt của premierleague.com cho phép crawl; Điều
# khoản sử dụng giới hạn ở "private and personal use" và nói phát hành lại cần chấp
# thuận bằng văn bản, nên giao diện luôn ghi rõ nguồn ở mọi chỗ hiện vai trò.
# Đo ngày 2026-09-09: 452 cầu thủ của 20 CLB, 86% có nhãn chi tiết, 32% phân biệt
# được trái/phải. Nhãn ghép hai biên ("Left/Right Winger") để TRỐNG, không đoán.
# Tệp PLAYER_ROLES_JSON (nếu có) ĐÈ LÊN nguồn này. Đặt false để tắt.
# PL_POSITIONS_ENABLED=true
# Ép một compSeason id cụ thể; 0 = tự lấy mùa mới nhất.
# PL_POSITIONS_SEASON_ID=0
