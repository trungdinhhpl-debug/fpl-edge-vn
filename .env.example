# Root env — used by docker-compose and shared config.
# Copy to .env and fill in. NEVER commit real secrets.

# Optional: The Odds API key (probability provider). Empty => internal model fallback.
# Free tier: https://the-odds-api.com/
ODDS_API_KEY=

# Market inversion (see docs/METHODOLOGY.md §2b). Defaults are fine.
# Asian handicap is the sharpest of the three markets, but a request costs
# (markets x regions) credits — including it takes a sync from 2 to 3.
# ODDS_INCLUDE_HANDICAP=true
# Relative weight of each market in the joint fit of the two lambdas.
# ODDS_WEIGHT_1X2=1.0
# ODDS_WEIGHT_TOTALS=1.0
# ODDS_WEIGHT_HANDICAP=1.0
# Dixon-Coles low-score correlation; 0 disables the correction.
# ODDS_DIXON_COLES_RHO=-0.13

# These are consumed by docker-compose service env blocks:
# (defaults already set in docker-compose.yml; override here if needed)
# PROJECTION_HORIZON=8
# MONTECARLO_ITERATIONS=10000

# ---- Chế độ tiền mùa (xem docs/METHODOLOGY.md §1b) ----
# FPL API KHÔNG công bố huấn luyện viên hay lịch sử chuyển nhượng, nên hai danh
# sách này phải khai bằng tay. Để rỗng = CHƯA AI KHAI, không phải "không có ai".
# NEW_MANAGER_CLUBS=TOT,MUN
# NEW_SIGNING_PLAYERS=427,481
# Mức tin vào dữ liệu mùa trước (thấp hơn = siết mạnh hơn về mức nền vị trí)
# PRIOR_WEIGHT_NEW_MANAGER=0.6
# PRIOR_WEIGHT_NEW_SIGNING=0.4
