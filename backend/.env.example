# ---- App ----
ENVIRONMENT=development
DEBUG=true
TIMEZONE=Asia/Ho_Chi_Minh

# ---- API ----
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ----
# dev (zero-config): SQLite file
DATABASE_URL=sqlite:///./fpl_edge.db
# prod example: postgresql+psycopg://fpl:fpl@localhost:5432/fpl_edge

# ---- Cache (optional) ----
# leave empty to use the in-memory TTL cache
REDIS_URL=
CACHE_TTL_SECONDS=900

# ---- Ingestion / jobs ----
AUTO_SYNC_ON_STARTUP=true
ENABLE_SCHEDULER=false
SYNC_PLAYERS_DETAIL=false

# ---- Modelling ----
PROJECTION_HORIZON=8
MONTECARLO_ITERATIONS=10000
MODEL_VERSION=xp-0.1.0

# ---- Optional external data (never commit real keys) ----
# The Odds API (probability provider). Empty => internal model fallback ("model estimate").
# Free tier 500 request/tháng; mỗi lần sync tốn 2 (h2h + totals).
ODDS_API_KEY=
# Mức tin vào đồng thuận nhà cái so với mô hình nội bộ (0..1)
ODDS_MARKET_WEIGHT=0.7

# Dữ liệu Championship mùa trước cho 3 đội mới lên hạng (miễn phí, không cần key).
# Chỉ dùng để xếp hạng các đội mới lên hạng so với nhau, luôn dưới mức TB Ngoại hạng.
# Đặt false để BỎ HẲN tính năng này (quay về mức nền phẳng cho mọi đội mới lên hạng).
CHAMPIONSHIP_ENABLED=true
# Mức độ "thành tích Championship chuyển hoá sang Ngoại hạng" (0 = bỏ qua, 1 = giữ nguyên)
CHAMPIONSHIP_DAMPING=0.35
UNDERSTAT_ENABLED=false
